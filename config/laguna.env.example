# Copy to ~/.config/ai-sync/laguna.env and chmod 600.
# Obtain every value below from the approved Laguna environment; do not guess.
# Do not put a credential in this file. cop-laguna reads it from macOS Keychain.

COPILOT_PROVIDER_BASE_URL=
COPILOT_PROVIDER_TYPE=
COPILOT_MODEL=
AI_SYNC_LAGUNA_CREDENTIAL_KIND=

# Optional only when the approved gateway requires them:
# COPILOT_PROVIDER_WIRE_API=
# COPILOT_PROVIDER_MODEL_ID=
# COPILOT_PROVIDER_WIRE_MODEL=
# AI_SYNC_LAGUNA_KEYCHAIN_SERVICE=ai-sync/copilot-laguna
# AI_SYNC_LAGUNA_KEYCHAIN_ACCOUNT=
