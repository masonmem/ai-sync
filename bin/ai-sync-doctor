#!/usr/bin/env bash
# ai-sync-doctor — verify (and with --fix, repair) the ai-sync link fan-out.
# Exits nonzero listing every failure. Companion to bin/ai-sync (which owns
# MCP registration, settings render/promote, and the bin/secrets links).
#
# Architecture verified here (2026-07 consolidation; repo IS ~/code/ai-sync,
# no ~/.ai-config compatibility symlink):
#   ~/.codex/AGENTS.md                  -> <repo>/agents/general.md   (skip if no ~/.codex)
#   ~/.claude/CLAUDE.md                 =  real file, exactly "@~/code/ai-sync/agents/general.md"
#   ~/.claude/rules/shared              -> <repo>/rules          (only if rules/ has content)
#   <hub>/<name>                        -> <repo>/skills/{general,personal}/<name>  (per skill)
#   ~/.agents/skills                    -> <hub>
#   ~/.copilot/copilot-instructions.md  -> <repo>/agents/general.md   (skip if no ~/.copilot)
#   ~/.copilot/skills                   -> <hub>  (or IS the hub on copilot-only machines)
#
# The skills hub is ~/.claude/skills when Claude Code is installed, else
# ~/.copilot/skills (copilot-only machines, e.g. work).
#
# Host scoping: skills/personal/* links are created ONLY on personal machines,
# identified by a hosts/<short-hostname>/ directory in the repo (navi, solaris).
# Machines without one (e.g. a work machine) get skills/general/* only, and
# --fix removes any personal links found there.
#
# --fix repairs missing or wrong SYMLINKS, converts the legacy layout
# (CLAUDE.md/skills as whole symlinks, ~/.ai-config compat symlink), and
# removes out-of-scope or dangling skill links. It never overwrites a real
# file or directory whose content it does not recognise.

set -u
REPO="${AI_SYNC_REPO:-$HOME/code/ai-sync}"
FIX=0
[ "${1:-}" = "--fix" ] && FIX=1
FAILS=0
HOSTN=$(hostname -s | tr '[:upper:]' '[:lower:]')

ok()    { printf '  \033[32m✓\033[0m %s\n' "$*"; }
fixed() { printf '  \033[33m⟳\033[0m %s\n' "$*"; }
fail()  { printf '  \033[31m✗\033[0m %s\n' "$*"; FAILS=$((FAILS + 1)); }
skip()  { printf '  \033[2m-\033[0m %s\n' "$*"; }

resolve() { readlink -f "$1" 2>/dev/null; }

check_link() { # $1=link $2=expected target
  local link=$1 want=$2 got
  if [ ! -L "$link" ] && [ -e "$link" ]; then
    fail "$link: real file/dir in the way (refusing to touch)"
    return
  fi
  if [ -L "$link" ] && [ "$(resolve "$link")" = "$(resolve "$want")" ]; then
    ok "$link -> $want"
    return
  fi
  if [ "$FIX" = 1 ]; then
    mkdir -p "$(dirname "$link")" && ln -sfn "$want" "$link" \
      && fixed "$link -> $want" \
      || fail "$link: could not create link"
  elif [ -L "$link" ]; then
    fail "$link -> $(readlink "$link") (expected $want)"
  else
    fail "$link: missing"
  fi
}

if [ -d "$REPO/hosts/$HOSTN" ]; then PERSONAL=1; else PERSONAL=0; fi

echo "ai-sync-doctor: repo=$REPO host=$HOSTN personal=$([ $PERSONAL = 1 ] && echo yes || echo no)$([ "$FIX" = 1 ] && echo ' (--fix)')"

[ -d "$REPO/agents" ] || { fail "$REPO/agents missing — wrong repo path? (clone to ~/code/ai-sync or set AI_SYNC_REPO)"; echo "ai-sync-doctor: $FAILS failure(s)"; exit 1; }

# legacy compat symlink from the ai-config era — should be gone
if [ -L "$HOME/.ai-config" ]; then
  if [ "$FIX" = 1 ]; then
    rm "$HOME/.ai-config" && fixed "removed legacy ~/.ai-config compat symlink"
  else
    fail "$HOME/.ai-config: legacy compat symlink still present (run --fix)"
  fi
elif [ -d "$HOME/.ai-config" ]; then
  fail "$HOME/.ai-config is a real directory — move it: mv ~/.ai-config ~/code/ai-sync, then re-run --fix"
else
  ok "no legacy ~/.ai-config (correct)"
fi

# skills hub: ~/.claude/skills preferred; ~/.copilot/skills on copilot-only machines
HUB=""
if [ -d "$HOME/.claude" ]; then HUB="$HOME/.claude/skills"
elif [ -d "$HOME/.copilot" ]; then HUB="$HOME/.copilot/skills"
fi

# codex (skip if codex isn't set up on this machine)
if [ -d "$HOME/.codex" ]; then
  check_link "$HOME/.codex/AGENTS.md" "$REPO/agents/general.md"
else
  skip "~/.codex absent; skipping codex link"
fi

# claude: CLAUDE.md is a REAL file containing exactly the @-import line
if [ -d "$HOME/.claude" ]; then
  CLAUDE_MD="$HOME/.claude/CLAUDE.md"
  EXPECT='@~/code/ai-sync/agents/general.md'
  if [ ! -L "$CLAUDE_MD" ] && [ -f "$CLAUDE_MD" ] && [ "$(cat "$CLAUDE_MD")" = "$EXPECT" ]; then
    ok "$CLAUDE_MD contains the @-import bridge"
  elif [ "$FIX" = 1 ] && { [ -L "$CLAUDE_MD" ] || [ ! -e "$CLAUDE_MD" ]; }; then
    rm -f "$CLAUDE_MD" && printf '%s' "$EXPECT" > "$CLAUDE_MD" \
      && fixed "$CLAUDE_MD written as @-import bridge"
  elif [ -L "$CLAUDE_MD" ]; then
    fail "$CLAUDE_MD: legacy symlink -> $(readlink "$CLAUDE_MD") (run --fix)"
  elif [ -f "$CLAUDE_MD" ]; then
    fail "$CLAUDE_MD: real file with unexpected content (merge it into agents/general.md or a skill, then re-run --fix)"
  else
    fail "$CLAUDE_MD: missing (run --fix)"
  fi

  # claude rules: link only when rules/ has real content
  if find "$REPO/rules" -type f ! -name '.gitkeep' 2>/dev/null | grep -q .; then
    check_link "$HOME/.claude/rules/shared" "$REPO/rules"
  else
    if [ -e "$HOME/.claude/rules/shared" ] || [ -L "$HOME/.claude/rules/shared" ]; then
      if [ "$FIX" = 1 ] && [ -L "$HOME/.claude/rules/shared" ]; then
        rm "$HOME/.claude/rules/shared" && fixed "removed ~/.claude/rules/shared (rules/ is empty)"
      else
        fail "$HOME/.claude/rules/shared exists but $REPO/rules is empty"
      fi
    else
      ok "rules/ empty; no ~/.claude/rules/shared link (correct)"
    fi
  fi
else
  skip "~/.claude absent; skipping claude checks"
fi

# skills hub: real dir of per-skill links
if [ -n "$HUB" ]; then
  if [ -L "$HUB" ]; then
    if [ "$FIX" = 1 ]; then
      rm "$HUB" && mkdir "$HUB" && fixed "$HUB: legacy whole-dir symlink replaced with real directory"
    else
      fail "$HUB: legacy whole-dir symlink (run --fix)"
    fi
  elif [ ! -d "$HUB" ]; then
    if [ "$FIX" = 1 ]; then
      mkdir -p "$HUB" && fixed "$HUB created"
    else
      fail "$HUB: missing"
    fi
  fi
  if [ -d "$HUB" ] && [ ! -L "$HUB" ]; then
    TIERS="general"
    [ "$PERSONAL" = 1 ] && TIERS="general personal"
    for tier in $TIERS; do
      for skill in "$REPO/skills/$tier"/*/; do
        [ -d "$skill" ] || continue
        check_link "$HUB/$(basename "$skill")" "$REPO/skills/$tier/$(basename "$skill")"
      done
    done
    for entry in "$HUB"/*; do
      [ -L "$entry" ] || continue
      target=$(resolve "$entry")
      if [ ! -e "$entry" ]; then
        if [ "$FIX" = 1 ]; then rm "$entry" && fixed "removed dangling skill link $entry"
        else fail "$entry: dangling skill link -> $(readlink "$entry")"; fi
      elif [ "$PERSONAL" = 0 ] && [ "${target#"$REPO/skills/personal/"}" != "$target" ]; then
        if [ "$FIX" = 1 ]; then rm "$entry" && fixed "removed personal skill link $entry (not a personal host)"
        else fail "$entry: personal skill linked on non-personal host"; fi
      fi
    done
  fi

  # agents-standard surface follows the hub
  check_link "$HOME/.agents/skills" "$HUB"
else
  skip "no ~/.claude or ~/.copilot; skipping skills hub"
fi

# copilot surface (skip if copilot isn't set up)
if [ -d "$HOME/.copilot" ]; then
  check_link "$HOME/.copilot/copilot-instructions.md" "$REPO/agents/general.md"
  if [ "$HUB" != "$HOME/.copilot/skills" ]; then
    check_link "$HOME/.copilot/skills" "$HUB"
  fi
else
  skip "~/.copilot absent; skipping copilot links"
fi

if [ "$FAILS" -gt 0 ]; then
  echo "ai-sync-doctor: $FAILS failure(s)"
  exit 1
fi
echo "ai-sync-doctor: all checks passed"
