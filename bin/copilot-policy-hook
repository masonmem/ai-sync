#!/usr/bin/env python3
"""Enforce the scoped Copilot writer/reviewer boundary without logging inputs."""

from __future__ import annotations

import json
import os
from pathlib import Path
import shlex
import sys


BOUNDARIES = {"writer", "reviewer"}
EDIT_TOOLS = {"create", "edit"}
DELETE_COMMANDS = {"rm", "rmdir", "unlink"}
MUTATING_GIT = {
    "branch",
    "checkout",
    "cherry-pick",
    "clean",
    "fetch",
    "merge",
    "notes",
    "pull",
    "push",
    "rebase",
    "replace",
    "reset",
    "revert",
    "switch",
    "tag",
    "update-ref",
    "worktree",
}
GIT_OPTIONS_WITH_VALUE = {
    "-C",
    "-c",
    "--exec-path",
    "--git-dir",
    "--namespace",
    "--super-prefix",
    "--work-tree",
}
PATH_KEYS = {"file", "filePath", "file_path", "path"}


def deny(reason: str) -> None:
    print(
        json.dumps(
            {
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        )
    )


def parsed_args(value: object) -> object:
    if isinstance(value, str):
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            return value
    return value


def file_paths(value: object) -> list[str]:
    found: list[str] = []
    if isinstance(value, dict):
        for key, child in value.items():
            if key in PATH_KEYS and isinstance(child, str):
                found.append(child)
            else:
                found.extend(file_paths(child))
    elif isinstance(value, list):
        for child in value:
            found.extend(file_paths(child))
    return found


def outside(root: Path, candidate: str) -> bool:
    path = Path(candidate).expanduser()
    if not path.is_absolute():
        path = root / path
    try:
        path.resolve(strict=False).relative_to(root.resolve(strict=False))
    except ValueError:
        return True
    return False


def shell_tokens(command: str) -> list[str]:
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|()")
        lexer.whitespace_split = True
        lexer.commenters = ""
        return list(lexer)
    except ValueError:
        return []


def git_subcommands(tokens: list[str]) -> list[str]:
    commands: list[str] = []
    for index, token in enumerate(tokens):
        if Path(token).name != "git":
            continue
        cursor = index + 1
        while cursor < len(tokens):
            current = tokens[cursor]
            if current == "--":
                cursor += 1
                break
            option = current.split("=", 1)[0]
            if option in GIT_OPTIONS_WITH_VALUE and "=" not in current:
                cursor += 2
                continue
            if current.startswith("-"):
                cursor += 1
                continue
            break
        if cursor < len(tokens):
            commands.append(tokens[cursor])
    return commands


def main() -> int:
    boundary = os.environ.get("AI_SYNC_AGENT_BOUNDARY")
    if boundary not in BOUNDARIES:
        return 0

    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        deny("The personal agent boundary could not parse this tool call.")
        return 0

    tool = payload.get("toolName") or payload.get("tool_name")
    args = parsed_args(payload.get("toolArgs", payload.get("tool_input", {})))
    cwd = Path(payload.get("cwd") or os.getcwd())

    if boundary == "reviewer" and tool in EDIT_TOOLS:
        deny("The invoke-only reviewer cannot edit or create files.")
        return 0

    if tool in EDIT_TOOLS:
        for candidate in file_paths(args):
            if outside(cwd, candidate):
                deny("The writer cannot modify files outside the session worktree.")
                return 0

    if tool not in {"bash", "powershell"} or not isinstance(args, dict):
        return 0
    command = args.get("command")
    if not isinstance(command, str):
        return 0
    tokens = shell_tokens(command)
    if any(Path(token).name in DELETE_COMMANDS for token in tokens):
        deny("Arbitrary path deletion is outside the personal agent boundary.")
        return 0
    if any(command in MUTATING_GIT for command in git_subcommands(tokens)):
        deny("This Git metadata or worktree operation requires an explicit unscoped session.")
        return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
