#!/usr/bin/env python3
"""ai-sync — manage the shared ~/.ai-config brain across multiple LLM clients.

Subcommands:
    status               show what's linked / broken / missing; MCP registration state.
    apply [--pull]       idempotent: re-link symlinks, re-register MCP servers, chmod +x.
    doctor               same checks as status, with a suggested fix per failure.
    diff [<target>]      for render-mode targets, show the diff between the file and
                         the expected render. Targets: claude, copilot, or omit for all.
    promote --to <where> [<target>]
                         move the current render drift into base (shared) or overlay
                         (per-host). <where> is `base` or `overlay`. Targets as above.
    mcp list             print the parsed mcp/servers.toml registry.
    test                 run the pytest suite under $AI_CONFIG/tests/.

Environment:
    AI_CONFIG   override the canonical brain location (default: ~/.ai-config).
"""

from __future__ import annotations

import difflib
import sys

if sys.version_info < (3, 11):
    sys.stderr.write(
        f"ai-sync requires Python 3.11+ (got {sys.version.split()[0]} at {sys.executable}).\n"
        "Hint: on macOS, Homebrew's python@3.14 lives at /opt/homebrew/bin/python3.\n"
        "Hint: in non-interactive contexts (launchd, ssh), ensure PATH starts with\n"
        "      /opt/homebrew/bin so the right interpreter resolves first.\n"
    )
    sys.exit(2)

import argparse
import json
import os
import pathlib
import shutil
import string
import subprocess
import tomllib
from dataclasses import dataclass
from typing import Iterable

# ── colors ───────────────────────────────────────────────────────────────────
_USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _c(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if _USE_COLOR else s


GREEN  = lambda s: _c("32", s)
RED    = lambda s: _c("31", s)
YELLOW = lambda s: _c("33", s)
CYAN   = lambda s: _c("36", s)
DIM    = lambda s: _c("90", s)
BOLD   = lambda s: _c("1",  s)

CHECK = GREEN("✓")
CROSS = RED("✗")
WARN  = YELLOW("!")

# ── paths ────────────────────────────────────────────────────────────────────
HOME      = pathlib.Path(os.environ.get("HOME", str(pathlib.Path.home())))
AI_CONFIG = pathlib.Path(os.environ.get("AI_CONFIG", str(HOME / ".ai-config")))

CLAUDE_HOME  = HOME / ".claude"
COPILOT_HOME = HOME / ".copilot"


@dataclass(frozen=True)
class Link:
    target_rel: str        # relative to AI_CONFIG
    link_path: pathlib.Path


# Source of truth for the symlink fan-out. Adding a new entry to either tool
# is a one-line change here.
#
# settings.json entries are intentionally in BOTH this table AND OVERLAYABLE
# below. The rule:
#   * If hosts/<hostname>/<overlay_name> exists → render (base + overlay merged
#     into a real file). Claude Code's runtime writes to the rendered file
#     become DRIFT and need to be promoted manually to base or overlay.
#   * Otherwise → symlink (v1 behaviour). Claude Code's writes flow straight
#     into the canonical tracked file and you just commit them.
CLAUDE_LINKS: list[Link] = [
    Link("instructions.md",       CLAUDE_HOME / "CLAUDE.md"),
    Link("skills",                CLAUDE_HOME / "skills"),
    Link("bin",                   CLAUDE_HOME / "bin"),
    Link("secrets",               CLAUDE_HOME / "secrets"),
    Link("claude/settings.json",  CLAUDE_HOME / "settings.json"),
]

COPILOT_LINKS: list[Link] = [
    Link("instructions.md",         COPILOT_HOME / "copilot-instructions.md"),
    Link("skills",                  COPILOT_HOME / "skills"),
    Link("bin",                     COPILOT_HOME / "bin"),
    Link("secrets",                 COPILOT_HOME / "secrets"),
    Link("mcp.json",                COPILOT_HOME / "mcp-config.json"),
    Link("copilot/settings.json",   COPILOT_HOME / "settings.json"),
]


@dataclass(frozen=True)
class Overlayable:
    """A file that can switch between symlink mode (no overlay) and render mode
    (overlay exists). The base file is also in *_LINKS; we override its handling
    here when an overlay is detected."""
    base_rel: str          # path relative to AI_CONFIG (the tracked base)
    output: pathlib.Path   # absolute path of the rendered file (also the symlink target)
    overlay_name: str      # file name searched under hosts/<host>/

    @property
    def base(self) -> pathlib.Path:
        return AI_CONFIG / self.base_rel

    def overlay_path(self, host: str) -> pathlib.Path:
        return AI_CONFIG / "hosts" / host / self.overlay_name

    def has_overlay(self, host: str) -> bool:
        return self.overlay_path(host).exists()


OVERLAYABLE: list[Overlayable] = [
    Overlayable("claude/settings.json",  CLAUDE_HOME / "settings.json",  "claude-settings.json"),
    Overlayable("copilot/settings.json", COPILOT_HOME / "settings.json", "copilot-settings.json"),
]


def overlayable_for(link: Link) -> Overlayable | None:
    """Return the Overlayable matching a Link by output path, or None."""
    for o in OVERLAYABLE:
        if o.output == link.link_path:
            return o
    return None


# ── helpers ──────────────────────────────────────────────────────────────────

def expand(value: str) -> str:
    """Expand ${AI_CONFIG} / ${HOME} placeholders without touching $-vars we don't own."""
    return string.Template(value).safe_substitute(
        AI_CONFIG=str(AI_CONFIG),
        HOME=str(HOME),
    )


def hostname() -> str:
    return os.uname().nodename.split(".")[0]


def load_servers() -> dict[str, dict]:
    """Load mcp/servers.toml. Returns {} if missing."""
    path = AI_CONFIG / "mcp" / "servers.toml"
    if not path.exists():
        return {}
    with path.open("rb") as f:
        return tomllib.load(f)


def selected_for_host(cfg: dict) -> bool:
    hosts = cfg.get("hosts")
    return not hosts or hostname() in hosts


def selected_for_client(cfg: dict, client: str) -> bool:
    clients = cfg.get("clients")
    return not clients or client in clients


def info(msg: str) -> None:
    print(f"{CYAN('[ai-sync]')} {msg}")


def warn(msg: str) -> None:
    print(f"{YELLOW('[ai-sync]')} {msg}", file=sys.stderr)


def err(msg: str) -> None:
    print(f"{RED('[ai-sync]')} {msg}", file=sys.stderr)


# ── relink ───────────────────────────────────────────────────────────────────

def relink_one(link: Link) -> tuple[str, str]:
    """Ensure link.link_path is a symlink to AI_CONFIG/link.target_rel.

    Returns (status, detail) where status is one of: created, updated, ok, target-missing.
    Never raises on routine drift; only on unrecoverable filesystem errors.
    """
    target = AI_CONFIG / link.target_rel
    if not target.exists():
        return ("target-missing", str(target))

    path = link.link_path
    if path.is_symlink():
        try:
            current = path.resolve(strict=False)
        except OSError:
            current = None
        if current == target.resolve():
            return ("ok", "")
        path.unlink()
        path.symlink_to(target)
        return ("updated", "")

    if path.exists():
        # Physical file/dir blocking the symlink — refuse to clobber blind.
        return ("blocked-by-existing", str(path))

    path.parent.mkdir(parents=True, exist_ok=True)
    path.symlink_to(target)
    return ("created", "")


def relink_all() -> bool:
    """Reconcile every Link.

    For ordinary links: ensure symlink points at canonical target (v1 behaviour).
    For Overlayable links: switch to symlink mode if the host has no overlay,
    or to render mode if it does. The two modes are mutually exclusive — if
    the host adds an overlay later, the existing symlink is replaced with a
    rendered file; if it removes one, the rendered file is replaced with a
    symlink (with a status warning if the file content diverged from canonical).
    """
    ok = True
    host = hostname()

    def handle(link: Link) -> bool:
        o = overlayable_for(link)
        if o is not None and o.has_overlay(host):
            return _apply_render(o, host)
        # Symlink path (also covers Overlayable links with no overlay present).
        # If the output is currently a non-symlink file (was rendered before
        # the overlay was removed), replace it with a symlink — but only if
        # its content matches canonical, otherwise refuse to avoid losing
        # Claude Code's runtime writes.
        if o is not None and link.link_path.is_file() and not link.link_path.is_symlink():
            if not _safe_to_replace_render_with_symlink(o):
                err(
                    f"{link.link_path} was rendered and now differs from canonical "
                    f"({link.target_rel}). Overlay was removed but rendered file has "
                    "local changes. Reconcile manually then rerun. "
                    f"(Diff: diff {link.target_rel} {link.link_path})"
                )
                return False
            link.link_path.unlink()
        status, detail = relink_one(link)
        if status == "created":
            info(f"link  {link.link_path} → {link.target_rel}")
        elif status == "updated":
            info(f"relink {link.link_path} → {link.target_rel}")
        elif status == "target-missing":
            warn(f"skip {link.link_path}: target missing ({detail})")
        elif status == "blocked-by-existing":
            err(f"refuse to clobber {detail} (not a symlink). Move it aside and rerun.")
            return False
        return True

    if CLAUDE_HOME.is_dir():
        for link in CLAUDE_LINKS:
            ok = handle(link) and ok
    if COPILOT_HOME.is_dir():
        for link in COPILOT_LINKS:
            ok = handle(link) and ok
    return ok


def _safe_to_replace_render_with_symlink(o: Overlayable) -> bool:
    """True iff o.output is semantically equivalent to o.base (so swapping
    the file for a symlink to base loses no information).

    Uses JSON equality, not byte equality — the rendered file uses indent=2
    while a hand-written base might be compact; both represent the same data
    and we shouldn't refuse the swap over cosmetic formatting.
    """
    if not o.base.exists() or not o.output.exists():
        return True
    try:
        return json.loads(o.output.read_text()) == json.loads(o.base.read_text())
    except json.JSONDecodeError:
        return False


def _apply_render(o: Overlayable, host: str) -> bool:
    """Render base + overlay → o.output. Refuses to overwrite if the existing
    rendered file has diverged from what the previous render would have produced
    (a sign that the tool wrote back to it)."""
    if not o.base.exists():
        warn(f"skip {o.output}: base missing ({o.base_rel})")
        return True
    try:
        rendered = render_text(o, host)
    except ValueError as e:
        err(str(e))
        return False

    target = o.output
    target.parent.mkdir(parents=True, exist_ok=True)

    if target.is_symlink():
        info(f"render {target} (was symlink) ← {o.base_rel} + hosts/{host}/{o.overlay_name}")
        target.unlink()
        target.write_text(rendered)
        return True

    if not target.exists():
        info(f"render {target} ← {o.base_rel} + hosts/{host}/{o.overlay_name}")
        target.write_text(rendered)
        return True

    if target.read_text() == rendered:
        return True  # noop, mtime stable

    # File exists, differs from current render. Either the user edited it by
    # hand, or the tool wrote back to it. Refuse to clobber unless --force.
    if _FORCE_APPLY:
        warn(f"--force: overwriting drifted {target}")
        target.write_text(rendered)
        return True
    err(
        f"{target} has drifted from `{o.base_rel} + hosts/{host}/{o.overlay_name}`. "
        f"Likely the tool wrote back to it. Promote the change to base or overlay, "
        f"or pass --force to discard."
    )
    return False


# ── render (base + host overlay → rendered file content) ─────────────────────

def deep_merge(base: dict, overlay: dict) -> dict:
    """Recursively merge overlay into base. Overlay wins on conflict.

    - Dicts merged recursively.
    - Lists, scalars, and mismatched types: overlay replaces base wholesale.
    - Does not mutate inputs.
    """
    result = dict(base)
    for key, ov in overlay.items():
        if key in result and isinstance(result[key], dict) and isinstance(ov, dict):
            result[key] = deep_merge(result[key], ov)
        else:
            result[key] = ov
    return result


def render_text(o: Overlayable, host: str) -> str:
    """Produce the merged JSON text for `o` on host `host`. Raises ValueError
    on JSON parse errors so the caller can report cleanly."""
    try:
        base_data = json.loads(o.base.read_text())
    except json.JSONDecodeError as e:
        raise ValueError(f"{o.base}: invalid JSON ({e})") from e

    overlay_path = o.overlay_path(host)
    if overlay_path.exists():
        try:
            overlay_data = json.loads(overlay_path.read_text())
        except json.JSONDecodeError as e:
            raise ValueError(f"{overlay_path}: invalid JSON ({e})") from e
        merged = deep_merge(base_data, overlay_data)
    else:
        merged = base_data

    return json.dumps(merged, indent=2) + "\n"


# ── chmod ────────────────────────────────────────────────────────────────────

def chmod_executables() -> None:
    """Ensure *.sh wrappers under bin/ are executable."""
    bin_dir = AI_CONFIG / "bin"
    if not bin_dir.is_dir():
        return
    for f in bin_dir.iterdir():
        if f.is_file() and f.suffix == ".sh":
            mode = f.stat().st_mode
            if not (mode & 0o111):
                f.chmod(mode | 0o111)


# ── mcp ──────────────────────────────────────────────────────────────────────

def claude_installed() -> bool:
    return shutil.which("claude") is not None


def claude_mcp_get(name: str) -> bool:
    """True iff `claude mcp get <name>` returns 0."""
    r = subprocess.run(
        ["claude", "mcp", "get", name],
        capture_output=True,
    )
    return r.returncode == 0


def claude_mcp_add(name: str, command: str, args: list[str]) -> bool:
    cmd = ["claude", "mcp", "add", "--scope", "user", name, command, *args]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        err(f"claude mcp add {name} failed: {r.stderr.strip()}")
        return False
    return True


def register_mcp_claude(servers: dict[str, dict]) -> bool:
    """For each server selected for this host+claude, ensure it's registered."""
    if not claude_installed():
        info("claude CLI not installed; skipping MCP registration")
        return True
    ok = True
    for name, cfg in servers.items():
        if not selected_for_host(cfg) or not selected_for_client(cfg, "claude"):
            continue
        if claude_mcp_get(name):
            info(f"mcp:claude:{name} already registered")
            continue
        command = expand(cfg["command"])
        args = [expand(a) for a in cfg.get("args", [])]
        if claude_mcp_add(name, command, args):
            info(f"mcp:claude:{name} registered → {command}")
        else:
            ok = False
    return ok


def copilot_mcp_state(servers: dict[str, dict]) -> dict[str, bool]:
    """Inspect the existing Copilot mcp.json and report which canonical servers are present."""
    copilot_mcp = AI_CONFIG / "mcp.json"
    if not copilot_mcp.exists():
        return {name: False for name in servers}
    try:
        data = json.loads(copilot_mcp.read_text())
    except json.JSONDecodeError:
        return {name: False for name in servers}
    declared = set(data.get("mcpServers", {}).keys())
    return {name: name in declared for name in servers}


def _server_entry_copilot(cfg: dict) -> dict:
    """Translate one servers.toml entry to its Copilot mcp.json shape."""
    entry = {
        "type": "local",
        "command": expand(cfg["command"]),
        "args": [expand(a) for a in cfg.get("args", [])],
        "env": {},
        "tools": ["*"],
    }
    return entry


def render_copilot_mcp_json(servers: dict[str, dict]) -> str:
    """Produce the canonical mcp.json text from servers.toml.

    Filters by host and client. Stable key order so identical inputs → identical
    output (enables byte-equal idempotency check).
    """
    selected = {
        name: _server_entry_copilot(cfg)
        for name, cfg in servers.items()
        if selected_for_host(cfg) and selected_for_client(cfg, "copilot")
    }
    payload = {"_generated_by": "ai-sync — edit mcp/servers.toml, not this file",
               "mcpServers": selected}
    return json.dumps(payload, indent=2, sort_keys=False) + "\n"


def write_copilot_mcp_json(servers: dict[str, dict]) -> None:
    """Write AI_CONFIG/mcp.json if its content would change. mtime-stable when idempotent."""
    path = AI_CONFIG / "mcp.json"
    rendered = render_copilot_mcp_json(servers)
    if path.exists() and path.read_text() == rendered:
        return
    path.write_text(rendered)
    info(f"wrote {path}")


# ── status ───────────────────────────────────────────────────────────────────

def _repo_state() -> tuple[str, bool]:
    """Return (branch-description, dirty)."""
    if not (AI_CONFIG / ".git").exists():
        return ("not a git repo", False)
    r = subprocess.run(
        ["git", "-C", str(AI_CONFIG), "status", "--porcelain=v1", "-b"],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        return ("git error", False)
    lines = r.stdout.splitlines()
    branch_line = lines[0] if lines else "??"
    dirty = any(not l.startswith("##") for l in lines)
    return (branch_line.removeprefix("## "), dirty)


@dataclass(frozen=True)
class CheckResult:
    """One row of status output. `fix` is the command-or-action `ai-sync doctor`
    prints; None means either nothing to fix or no automated suggestion."""
    category: str       # "symlinks" | "mcp" | "secrets"
    mark: str           # CHECK / CROSS / WARN
    description: str    # one-line summary printed by status
    fix: str | None     # suggested remediation, printed by doctor

    @property
    def ok(self) -> bool:
        return self.mark == CHECK


def _link_check(link: Link) -> CheckResult:
    """Check one Link (or Overlayable in render mode if its overlay exists)."""
    target = AI_CONFIG / link.target_rel
    path = link.link_path
    if not target.exists():
        return CheckResult(
            "symlinks", CROSS,
            f"{path}  TARGET MISSING ({link.target_rel})",
            f"Restore {target} (was it deleted or renamed in mcp/servers.toml?)",
        )

    host = hostname()
    o = overlayable_for(link)
    if o is not None and o.has_overlay(host):
        # render mode
        if not path.exists():
            return CheckResult(
                "symlinks", CROSS,
                f"{path}  NOT RENDERED",
                "ai-sync apply",
            )
        if path.is_symlink():
            return CheckResult(
                "symlinks", CROSS,
                f"{path}  STILL A SYMLINK (overlay exists; should be rendered)",
                "ai-sync apply",
            )
        try:
            expected = render_text(o, host)
        except ValueError as e:
            return CheckResult(
                "symlinks", CROSS,
                f"{path}  RENDER ERROR: {e}",
                f"Fix JSON syntax in {o.overlay_path(host)} or {o.base}",
            )
        if path.read_text() == expected:
            return CheckResult(
                "symlinks", CHECK,
                f"{path} ← {link.target_rel} + hosts/{host}/{o.overlay_name}",
                None,
            )
        target_short = o.overlay_name.split("-")[0]  # "claude-settings.json" → "claude"
        return CheckResult(
            "symlinks", CROSS,
            f"{path}  DRIFTED (likely Claude Code wrote back)",
            f"ai-sync diff {target_short}  # inspect, then\n"
            f"  ai-sync promote --to overlay {target_short}  # keep per-host, OR\n"
            f"  ai-sync promote --to base {target_short}     # share across all hosts, OR\n"
            f"  ai-sync apply --force                        # discard the drift",
        )

    # symlink mode
    if path.is_symlink():
        try:
            resolved = path.resolve(strict=False)
        except OSError:
            return CheckResult("symlinks", CROSS, f"{path}  UNREADABLE SYMLINK",
                               f"rm {path} && ai-sync apply")
        if resolved == target.resolve():
            return CheckResult("symlinks", CHECK, f"{path} → {link.target_rel}", None)
        return CheckResult(
            "symlinks", CROSS,
            f"{path} → {resolved} (expected {target}) DRIFTED",
            f"rm {path} && ai-sync apply",
        )
    if path.exists():
        return CheckResult(
            "symlinks", CROSS,
            f"{path}  NOT A SYMLINK",
            f"Move it aside: mv {path} {path}.bak && ai-sync apply",
        )
    return CheckResult("symlinks", CROSS, f"{path}  MISSING", "ai-sync apply")


def _mcp_checks(name: str, cfg: dict, copilot_state: dict[str, bool]) -> list[CheckResult]:
    """Return the three (or fewer) check rows for one MCP server entry."""
    rows: list[CheckResult] = []
    if not selected_for_host(cfg):
        rows.append(CheckResult("mcp", CHECK, f"{name}  (skipped on host {hostname()})", None))
        return rows

    # claude
    if not claude_installed():
        rows.append(CheckResult("mcp", CHECK, f"{name} claude:   (claude CLI not installed)", None))
    elif not selected_for_client(cfg, "claude"):
        rows.append(CheckResult("mcp", CHECK, f"{name} claude:   (skipped)", None))
    elif claude_mcp_get(name):
        rows.append(CheckResult("mcp", CHECK, f"{name} claude:   registered", None))
    else:
        rows.append(CheckResult(
            "mcp", CROSS, f"{name} claude:   NOT REGISTERED",
            "ai-sync apply",
        ))

    # copilot
    if not selected_for_client(cfg, "copilot"):
        rows.append(CheckResult("mcp", CHECK, f"{name} copilot:  (skipped)", None))
    elif copilot_state.get(name):
        rows.append(CheckResult("mcp", CHECK, f"{name} copilot:  present in mcp.json", None))
    else:
        rows.append(CheckResult(
            "mcp", CROSS, f"{name} copilot:  NOT in mcp.json",
            "ai-sync apply  # regenerates mcp.json from servers.toml",
        ))

    # secrets file
    if "secrets_env" in cfg:
        sp = pathlib.Path(expand(cfg["secrets_env"]))
        if not sp.exists():
            rows.append(CheckResult(
                "secrets", CROSS, f"{name} secrets:  {sp}  MISSING",
                f"Create {sp} with chmod 600 — see the wrapper script's header for required env vars",
            ))
        else:
            mode = sp.stat().st_mode & 0o777
            if mode & 0o077:
                rows.append(CheckResult(
                    "secrets", WARN, f"{name} secrets:  {sp}  loose perms ({oct(mode)})",
                    f"chmod 600 {sp}",
                ))
            else:
                rows.append(CheckResult(
                    "secrets", CHECK, f"{name} secrets:  {sp}  ({oct(mode)})", None,
                ))
    return rows


def _all_checks() -> list[CheckResult]:
    """Gather every check. Shared between status and doctor."""
    rows: list[CheckResult] = []
    if CLAUDE_HOME.is_dir():
        rows.extend(_link_check(link) for link in CLAUDE_LINKS)
    if COPILOT_HOME.is_dir():
        rows.extend(_link_check(link) for link in COPILOT_LINKS)
    servers = load_servers()
    copilot_state = copilot_mcp_state(servers)
    for name, cfg in servers.items():
        rows.extend(_mcp_checks(name, cfg, copilot_state))
    return rows


def _print_header() -> None:
    branch, dirty = _repo_state()
    dirty_tag = ", dirty" if dirty else ""
    print(f"{BOLD(str(AI_CONFIG))}  (host: {hostname()}, repo: {branch}{dirty_tag})")
    print()


def _drift_exit_code(rows: list[CheckResult]) -> int:
    return 1 if any(r.mark != CHECK for r in rows) else 0


def status_cmd() -> int:
    """Print status; return 0 if clean, 1 if anything is drifted."""
    _print_header()
    rows = _all_checks()

    print("symlinks:")
    sym_rows = [r for r in rows if r.category == "symlinks"]
    if not sym_rows:
        print(f"  {DIM('(no tool homes present)')}")
    for r in sym_rows:
        print(f"  {r.mark} {r.description}")
    print()

    mcp_rows = [r for r in rows if r.category in ("mcp", "secrets")]
    print("mcp servers (canonical: mcp/servers.toml):")
    if not mcp_rows:
        print(f"  {DIM('(none declared)')}")
    for r in mcp_rows:
        print(f"  {r.mark} {r.description}")

    return _drift_exit_code(rows)


def doctor_cmd() -> int:
    """Same checks as status, plus a per-failure suggested fix."""
    _print_header()
    rows = _all_checks()
    failures = [r for r in rows if r.mark != CHECK]

    if not failures:
        print(GREEN("✓ Everything looks good — no fixes needed."))
        return 0

    print(f"{BOLD('Found ' + str(len(failures)) + ' issue(s).')} Suggested fixes:\n")
    for r in failures:
        print(f"  {r.mark} {r.description}")
        if r.fix:
            for line in r.fix.splitlines():
                print(f"    {DIM('→')} {line}")
        else:
            print(f"    {DIM('→')} (no automated fix; investigate manually)")
        print()

    return _drift_exit_code(rows)


# ── apply ────────────────────────────────────────────────────────────────────

def git_pull() -> bool:
    """git pull --ff-only the AI_CONFIG repo. Refuses on dirty tree."""
    if not (AI_CONFIG / ".git").exists():
        warn(f"{AI_CONFIG} is not a git repo; skipping pull")
        return True
    dirty = subprocess.run(
        ["git", "-C", str(AI_CONFIG), "diff", "--quiet"]
    ).returncode != 0 or subprocess.run(
        ["git", "-C", str(AI_CONFIG), "diff", "--quiet", "--cached"]
    ).returncode != 0
    if dirty:
        err("working tree dirty; refusing to pull. Commit or stash first.")
        return False
    info("git pull --ff-only")
    r = subprocess.run(
        ["git", "-C", str(AI_CONFIG), "pull", "--ff-only"],
    )
    return r.returncode == 0


def apply_cmd(pull: bool, force: bool = False) -> int:
    if pull and not git_pull():
        return 1
    chmod_executables()
    servers = load_servers()
    # Write the Copilot mcp.json BEFORE re-linking so a fresh machine doesn't
    # briefly see a dangling symlink.
    write_copilot_mcp_json(servers)
    global _FORCE_APPLY
    _FORCE_APPLY = force
    try:
        if not relink_all():
            return 1
    finally:
        _FORCE_APPLY = False
    if not register_mcp_claude(servers):
        return 1
    info("apply complete")
    return 0


# Module-level flag toggled by apply_cmd. Cleaner than threading it through
# every helper. Read by _apply_render.
_FORCE_APPLY = False


# ── diff / promote (render-mode reconciliation) ──────────────────────────────

def resolve_target(short_name: str | None) -> list[Overlayable]:
    """Map a short name ("claude", "copilot") to its Overlayable(s).
    `None` means "all overlayable targets".
    """
    if short_name is None:
        return list(OVERLAYABLE)
    matches = [o for o in OVERLAYABLE if o.overlay_name.split("-")[0] == short_name]
    if not matches:
        valid = ", ".join(sorted({o.overlay_name.split("-")[0] for o in OVERLAYABLE}))
        err(f"unknown target {short_name!r}. Valid: {valid}")
        return []
    return matches


def _drift_state(o: Overlayable, host: str) -> tuple[dict | None, dict | None, str]:
    """Return (actual_data, expected_data, reason).

    reason describes the situation; one of:
      'no-overlay'           — render mode not active for this host
      'no-output'            — output file doesn't exist
      'not-rendered'         — output is still a symlink
      'clean'                — actual == expected (no drift)
      'drifted'              — actual differs from expected
      'invalid-overlay'      — overlay JSON parse error
      'invalid-base'         — base JSON parse error
      'invalid-actual'       — rendered file's JSON parse error
    """
    if not o.has_overlay(host):
        return (None, None, "no-overlay")
    if not o.output.exists():
        return (None, None, "no-output")
    if o.output.is_symlink():
        return (None, None, "not-rendered")
    try:
        expected_text = render_text(o, host)
    except ValueError as e:
        if "overlay" in str(e).lower() or str(o.overlay_path(host)) in str(e):
            return (None, None, "invalid-overlay")
        return (None, None, "invalid-base")
    try:
        actual = json.loads(o.output.read_text())
    except json.JSONDecodeError:
        return (None, None, "invalid-actual")
    expected = json.loads(expected_text)
    if actual == expected:
        return (actual, expected, "clean")
    return (actual, expected, "drifted")


def diff_cmd(target_name: str | None) -> int:
    """Print a unified diff between each render-mode target's file and its
    expected render. Exit 0 if everything matches, 1 if anything drifted."""
    targets = resolve_target(target_name)
    if not targets:
        return 1

    host = hostname()
    any_drift = False
    any_reportable = False

    for o in targets:
        short = o.overlay_name.split("-")[0]
        actual, expected, reason = _drift_state(o, host)

        if reason == "no-overlay":
            info(f"{short}: symlink mode (no overlay for host {host}); nothing to diff")
            continue
        any_reportable = True
        if reason == "no-output":
            err(f"{short}: {o.output} doesn't exist yet — run `ai-sync apply`")
            any_drift = True
            continue
        if reason == "not-rendered":
            err(f"{short}: {o.output} is still a symlink — run `ai-sync apply`")
            any_drift = True
            continue
        if reason == "invalid-overlay":
            err(f"{short}: overlay {o.overlay_path(host)} has invalid JSON")
            any_drift = True
            continue
        if reason == "invalid-base":
            err(f"{short}: base {o.base} has invalid JSON")
            any_drift = True
            continue
        if reason == "invalid-actual":
            err(f"{short}: rendered file {o.output} has invalid JSON")
            any_drift = True
            continue
        if reason == "clean":
            print(f"{CHECK} {short}: clean (matches base + hosts/{host}/{o.overlay_name})")
            continue

        # drifted
        any_drift = True
        print(BOLD(f"{short}: {o.output} ↔ expected (base + hosts/{host}/{o.overlay_name})"))
        expected_text = json.dumps(expected, indent=2, sort_keys=True) + "\n"
        actual_text   = json.dumps(actual,   indent=2, sort_keys=True) + "\n"
        diff = difflib.unified_diff(
            expected_text.splitlines(keepends=True),
            actual_text.splitlines(keepends=True),
            fromfile=f"expected (base + overlay)",
            tofile=f"actual ({o.output})",
        )
        for line in diff:
            if line.startswith("+") and not line.startswith("+++"):
                print(GREEN(line.rstrip()))
            elif line.startswith("-") and not line.startswith("---"):
                print(RED(line.rstrip()))
            elif line.startswith("@@"):
                print(CYAN(line.rstrip()))
            else:
                print(line.rstrip())
        print()

    if not any_reportable:
        info("no targets in render mode for this host (nothing to diff)")
        return 0
    return 1 if any_drift else 0


def _drift_changeset(actual: dict, expected: dict) -> dict:
    """Top-level diff: keys present in actual that differ from (or are absent in)
    expected. Returns a dict suitable for shallow-merging into base or overlay.

    Limitation: nested-key changes promote the whole top-level key. Documented
    in docs/architecture.md.
    """
    changes: dict = {}
    for key, val in actual.items():
        if key not in expected or expected[key] != val:
            changes[key] = val
    return changes


def _write_json_pretty(path: pathlib.Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def promote_cmd(target_name: str | None, where: str) -> int:
    """Move render drift into base ('base') or per-host overlay ('overlay')."""
    if where not in ("base", "overlay"):
        err(f"--to must be 'base' or 'overlay', got {where!r}")
        return 1

    targets = resolve_target(target_name)
    if not targets:
        return 1

    host = hostname()
    any_drift = False
    any_warning = False

    for o in targets:
        short = o.overlay_name.split("-")[0]
        actual, expected, reason = _drift_state(o, host)

        if reason == "no-overlay":
            info(f"{short}: symlink mode for this host; nothing to promote")
            continue
        if reason == "clean":
            info(f"{short}: no drift; nothing to promote")
            continue
        if reason != "drifted":
            err(f"{short}: cannot promote ({reason})")
            any_warning = True
            continue

        changes = _drift_changeset(actual, expected)
        if not changes:
            info(f"{short}: drifted only on removed keys; promote not yet supported for deletions")
            continue
        any_drift = True

        if where == "overlay":
            overlay_path = o.overlay_path(host)
            overlay_data = json.loads(overlay_path.read_text())
            merged = deep_merge(overlay_data, changes)
            _write_json_pretty(overlay_path, merged)
            info(f"{short}: promoted {len(changes)} key(s) to {overlay_path}: {sorted(changes.keys())}")
        else:  # base
            base_data = json.loads(o.base.read_text())
            overlay_data = json.loads(o.overlay_path(host).read_text())
            merged = deep_merge(base_data, changes)
            _write_json_pretty(o.base, merged)
            info(f"{short}: promoted {len(changes)} key(s) to {o.base}: {sorted(changes.keys())}")
            # Warn about keys also present in overlay — they'll still win.
            shadowed = [k for k in changes if k in overlay_data]
            if shadowed:
                warn(
                    f"{short}: {sorted(shadowed)} also exist in the overlay; "
                    f"they'll still win on this host. Delete from overlay if you want "
                    f"the base value to take effect."
                )
                any_warning = True

    if any_drift:
        info("re-applying to clear the drift…")
        # --force is correct here: we just promoted the drift, so any remaining
        # difference between rendered file and new expected render is cosmetic
        # (formatting). The semantic content is already preserved in base/overlay.
        rc = apply_cmd(pull=False, force=True)
        if rc != 0:
            return rc
    return 1 if any_warning else 0


# ── mcp list ─────────────────────────────────────────────────────────────────

def mcp_list_cmd() -> int:
    servers = load_servers()
    if not servers:
        print(DIM("(no MCP servers declared in mcp/servers.toml)"))
        return 0
    for name, cfg in servers.items():
        print(BOLD(name))
        if "description" in cfg:
            print(f"  {cfg['description']}")
        for k in ("command", "args", "secrets_env", "hosts", "clients"):
            if k in cfg:
                val = cfg[k]
                if k in ("command", "secrets_env") and isinstance(val, str):
                    val = expand(val)
                print(f"  {k} = {val}")
        print()
    return 0


# ── test ─────────────────────────────────────────────────────────────────────

def test_cmd(pytest_args: list[str]) -> int:
    tests_dir = AI_CONFIG / "tests"
    if not tests_dir.is_dir():
        err(f"no tests/ directory at {tests_dir}")
        return 1
    pytest_bin = shutil.which("pytest")
    if pytest_bin is None:
        err("pytest not found on PATH. Install with: pipx install pytest")
        return 1
    return subprocess.run([pytest_bin, str(tests_dir), *pytest_args]).returncode


# ── main ─────────────────────────────────────────────────────────────────────

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="ai-sync", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="show link / MCP state, exit 1 if drifted")
    a = sub.add_parser("apply", help="re-link symlinks, re-register MCP servers")
    a.add_argument("--pull", action="store_true", help="git pull --ff-only first")
    a.add_argument("--force", action="store_true",
                   help="overwrite rendered files even if they've drifted (loses tool writebacks)")

    sub.add_parser("doctor", help="status + suggested fix for each failure")

    d = sub.add_parser("diff", help="diff render-mode files against their expected render")
    d.add_argument("target", nargs="?", help="claude | copilot (omit for all)")

    p = sub.add_parser("promote", help="move render drift into base or overlay")
    p.add_argument("--to", required=True, choices=("base", "overlay"),
                   help="promote drift to the shared base file or the per-host overlay")
    p.add_argument("target", nargs="?", help="claude | copilot (omit for all drifted)")

    m = sub.add_parser("mcp", help="MCP registry operations")
    m_sub = m.add_subparsers(dest="mcp_cmd", required=True)
    m_sub.add_parser("list", help="print canonical mcp/servers.toml entries")

    t = sub.add_parser("test", help="run the pytest suite")
    t.add_argument("pytest_args", nargs=argparse.REMAINDER)

    args = parser.parse_args(argv)

    if args.cmd == "status":
        return status_cmd()
    if args.cmd == "apply":
        return apply_cmd(pull=args.pull, force=args.force)
    if args.cmd == "doctor":
        return doctor_cmd()
    if args.cmd == "diff":
        return diff_cmd(args.target)
    if args.cmd == "promote":
        return promote_cmd(args.target, where=args.to)
    if args.cmd == "mcp":
        if args.mcp_cmd == "list":
            return mcp_list_cmd()
    if args.cmd == "test":
        return test_cmd(args.pytest_args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
