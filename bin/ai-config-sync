#!/usr/bin/env bash
# ai-config-sync — pull and apply, in one shot.
#
# Now a thin shim around `ai-sync apply --pull`. The original symlink and MCP
# logic moved into the Python CLI so it could be tested.
#
# Why this script still exists:
#   * The optional launchd timer (launchd/sh.user.ai-config-sync.plist, not
#     installed by default) calls it by this name.
#   * Remote invocation (`ssh host '~/code/ai-sync/bin/ai-config-sync'`) needs
#     the PATH fix below; a bare ai-sync call finds only system Python 3.9.
#   * Sibling to ~/dotfiles/bin/dotfiles-sync — same shape, different repo.
#
# All arguments are passed through. Common forms:
#   ai-config-sync                # git pull + apply
#   ai-config-sync --no-pull      # apply without pulling (ai-sync apply)

set -euo pipefail

# launchd timers and non-interactive ssh spawn this with a minimal PATH that
# excludes /opt/homebrew/bin, which leaves only the system Python 3.9 visible
# (no `tomllib`). Prepend Homebrew so ai-sync's `#!/usr/bin/env python3`
# shebang picks up Python 3.14.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

AI_CONFIG="${AI_CONFIG:-$HOME/code/ai-sync}"
AI_SYNC="$AI_CONFIG/bin/ai-sync"

if [[ ! -x "$AI_SYNC" ]]; then
  printf '\033[31m[ai-config-sync]\033[0m ai-sync not found at %s\n' "$AI_SYNC" >&2
  printf '  cd %s && git pull --ff-only\n' "$AI_CONFIG" >&2
  printf '  then rerun this script.\n' >&2
  exit 1
fi

case "${1:-}" in
  --no-pull) shift; exec "$AI_SYNC" apply "$@" ;;
  *)         exec "$AI_SYNC" apply --pull "$@" ;;
esac
