#!/usr/bin/env bash
# Launch the invoke-only read-only reviewer.

set -euo pipefail

provider="${1:-cloud}"
case "$provider" in
  cloud|laguna) shift || true ;;
  *) provider="cloud" ;;
esac

export AI_SYNC_AGENT_BOUNDARY=reviewer
export COPILOT_MAX_AI_CREDITS="${COPILOT_MAX_AI_CREDITS:-50}"
launcher="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/cop-$provider"
exec "$launcher" \
  --agent ui-code-review-agent \
  --disallow-temp-dir \
  --deny-tool=write \
  "$@"
