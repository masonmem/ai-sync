#!/usr/bin/env bash
# secrets-push — sync ~/code/ai-sync/secrets/ with another Mac (over SSH).
#
# Replaces the legacy ~/dotfiles/bin/secrets-push (which mirrored with
# --delete-after by default — destructive when the two Macs have drifted).
# This version never deletes unless you ask, and can pull as well as push.
#
# Usage:
#   secrets-push [host]              # push local → host; copies/overwrites, NEVER deletes
#   secrets-push --prune [host]      # push + delete remote strays (dry-run preview + confirm)
#   secrets-push --pull [host]       # pull host → local; newest-wins (-u), never deletes
#
# Default host: solaris (the always-on box). Any SSH alias works.
#
# Which files belong on which machine is recorded in the tracked
# secrets/manifest.toml — `ai-sync doctor` checks it per host. `*.bak`
# cruft and manifest.toml itself (tracked in git) are excluded from sync.
set -euo pipefail

MODE="push"
case "${1:-}" in
  --pull)  MODE="pull";  shift ;;
  --prune) MODE="prune"; shift ;;
  -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
esac

HOST="${1:-solaris}"
LOCAL_DIR="$HOME/code/ai-sync/secrets"
LOCAL="$LOCAL_DIR/"
REMOTE="$HOST:code/ai-sync/secrets/"
EXCLUDES=(--exclude '*.bak' --exclude 'manifest.toml')

tighten_local() { chmod 700 "$LOCAL_DIR"; chmod 600 "$LOCAL_DIR"/* 2>/dev/null || true; }
tighten_remote() { ssh "$HOST" 'chmod 700 ~/code/ai-sync/secrets && chmod 600 ~/code/ai-sync/secrets/* 2>/dev/null || true'; }

verify() {
  echo
  echo "→ verifying hashes (local vs $HOST, manifest.toml/*.bak excluded):"
  diff <(cd "$LOCAL" && shasum -- * 2>/dev/null | grep -v -e 'manifest\.toml' -e '\.bak$' | sort) \
       <(ssh "$HOST" 'cd ~/code/ai-sync/secrets && shasum -- * 2>/dev/null' | grep -v -e 'manifest\.toml' -e '\.bak$' | sort) \
    && echo "✓ in sync" || echo "✗ differs (expected if some files are scoped to one host — see secrets/manifest.toml)"
}

case "$MODE" in
  pull)
    echo "→ pulling $REMOTE → $LOCAL (newest-wins, no deletions)"
    rsync -au -v "${EXCLUDES[@]}" "$REMOTE" "$LOCAL"
    tighten_local
    verify
    ;;
  push)
    echo "→ pushing $LOCAL → $REMOTE (no deletions; use --prune to delete remote strays)"
    rsync -a -v "${EXCLUDES[@]}" "$LOCAL" "$REMOTE"
    tighten_remote
    verify
    ;;
  prune)
    echo "→ DRY RUN: push with deletion of remote strays ($LOCAL → $REMOTE)"
    rsync -an -v --delete-after "${EXCLUDES[@]}" "$LOCAL" "$REMOTE"
    printf '\nProceed with the sync above (including deletions)? [y/N] '
    read -r answer
    [[ "$answer" == [yY] ]] || { echo "aborted."; exit 1; }
    rsync -a -v --delete-after "${EXCLUDES[@]}" "$LOCAL" "$REMOTE"
    tighten_remote
    verify
    ;;
esac
