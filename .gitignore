# --- Machine-local secrets (sourced by bin/*-wrapper.sh) ---
# `secrets/*` (not `secrets/`) so the tracked manifest below can be re-included
# — git can't re-include a file whose parent directory is excluded.
secrets/*
!secrets/manifest.toml

# --- Wrapper-script runtime side-effects (audit logs, etc.) ---
state/

# --- Defensive: CLI-managed runtime state, in case ~/.ai-config is ever
#     accidentally pointed at by a CLI as its runtime dir. ---
config.json
permissions-config.json
command-history-state.json
command-history-state/
session-state/
session-store.db
session-store.db-shm
session-store.db-wal
logs/
ide/
restart/
installed-plugins/
plugin-data/
vscode.session.metadata.cache.json

# --- pytest / ai-sync test runner ---
.pytest_cache/
__pycache__/
*.pyc

# --- Editor noise ---
.DS_Store
*.swp
